<%#= link_to "New declare", new_declare_path %>-->

<div id="declares">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Declare Category List</h3>
      <% if current_user.leader? %>
        <%= link_to new_declare_path, class: 'btn btn-success btn-sm float-right' do %>
          <i class="fa fa-plus-square"></i> New
        <% end %>
      <% end %>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
      <table id="declares-table" class="table table-bordered table-striped">
        <thead>
          <tr>
            <th><%= sort_link(@q, :user_user_information_full_name, 'Name') %></th>
            <th><%= sort_link(@q, :user_patner_patner_name, 'Patner') %></th>
            <th><%= sort_link(@q, :declare_category_id, 'Category') %></th>
            <th><%= sort_link(@q, :status, [:status, 'updated_at desc'], 'Status') %></th>
            <th><%= sort_link(@q, :amount, 'Amount') %></th>
            <th>Payout Channel</th>
            <th>Proof</th>
            <th><%= sort_link(@q, :created_at, 'Created At') %></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @declares.each do |declare| %>
            <%= render declare %>
          <% end %>
        </tbody>
      </table>
      <%= paginate @declares %>
      <div class="mt-2">
        <%= page_entries_info @declares %>
      </div>
    </div>
  </div>
</div>
