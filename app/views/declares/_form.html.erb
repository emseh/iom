<%= simple_form_for(@declare, html: { class: 'form-horizontal' }) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="card">
    <div class="card-body">
      <div class="form-group row">
        <%= f.label :declare_category, 'Select Category', class: 'col-sm-2 col-form-label' %>
        <div class="col-sm-10">
          <%= f.collection_select :declare_category_id, MemoCategory.all, :id, :name, { prompt: 'Choose a Category' }, class: 'form-control' %>
          <%= f.error :declare_category, class: 'text-danger' %>
        </div>
      </div>
      <div class="form-group row">
        <%= f.label :description, class: 'col-sm-2 col-form-label' %>
        <div class="col-sm-10">
          <%= f.rich_text_area :description, class: 'form-control', placeholder: 'Enter Description' %>
          <%= f.error :description, class: 'text-danger' %>
        </div>
      </div>
      <div class="form-group row">
        <%= f.label :amount, class: 'col-sm-2 col-form-label' %>
        <div class="col-sm-10">
          <%= f.number_field :amount, class: 'form-control', placeholder: 'Enter Amount', value: @declare.amount.nil? ? params.dig(:declare, :amount) || 0 : @declare.amount.to_i %>
          <%= f.error :amount, class: 'text-danger' %>
        </div>
      </div>
      <div class="form-group row">
        <%= f.label :bank_account, 'Bank Account', class: 'col-sm-2 col-form-label' %>
        <div class="col-sm-10">
          <%= f.collection_select :bank_account_id, current_user.bank_accounts, :id, :details, { prompt: 'Choose Your Bank Account' }, class: 'form-control' %>
          <%= f.error :bank_account, class: 'text-danger' %>
        </div>
      </div>
      <div class="form-group row">
        <%= f.label :declare_proof, class: 'col-sm-2 col-form-label' %>
        <div class="col-sm-10">
          <%= f.input :declare_proof, as: :file, class: 'form-control', label: false %>
          <%= f.error :declare_proof, class: 'text-danger' %>
        </div>
      </div>

      <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
          <%= f.button :submit, class: 'btn btn-primary' %>
        </div>
      </div>
    </div>
  </div>
<% end %>