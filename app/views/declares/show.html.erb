<div class="card">
  <div class="card-header">
    <h3 class="card-title">Declare Details</h3>
  </div>
  <!-- /.card-header -->
  <div class="card-body">
    <table class="table table-bordered table-striped" id="<%= dom_id(@declare) %>">
      <tbody>
        <tr>
          <td><strong>Name</strong></td>
          <td><%= @declare&.user&.user_information&.full_name %></td>
        </tr>
        <tr>
          <td><strong>Phone Number</strong></td>
          <td><%= @declare&.user&.user_information&.phone_number %></td>
        </tr>
        <tr>
          <td><strong>Patner</strong></td>
          <td><%= @declare&.user&.patner&.name %></td>
        </tr>
        <tr>
          <td><strong>Category</strong></td>
          <td><%= @declare&.declare_category&.name %></td>
        </tr>
        <tr>
          <td><strong>Status</strong></td>
          <td><%= @declare&.status&.upcase %></td>
        </tr>
        <tr>
          <td><strong>Created At</strong></td>
          <td><%= formatted_date(@declare&.created_at) %></td>
        </tr>
        <tr>
          <td><strong>Description</strong></td>
          <td><%= @declare&.description %></td>
        </tr>
        <tr>
          <td><strong>Amount</strong></td>
          <td><%= format_to_indonesian_currency(@declare&.amount) %></td>
        </tr>
        <tr>
          <td><strong>Bank Account</strong></td>
          <td><%= @declare&.bank_account&.details %></td>
        </tr>
        <tr>
          <td><strong>Proof</strong></td>
          <td>
            <% if @declare.declare_proof? %>
              <%= image_tag @declare.declare_proof.url, alt: 'Proof Image', size: 512 %>
            <% else %>
              No proof uploaded
            <% end %>
          </td>
        </tr>
        <tr>
          <td colspan="3" class="text-right">
            <%= link_to declares_path, class: 'btn btn-secondary btn-sm' do %>
              <i class="fa fa-chevron-left"></i> Back
            <% end %>
            <% if @declare.paid? && @declare.declare_proof? && current_user.admin? %>
              <%= link_to finish_declare_path(@declare), data: { turbo_method: :post, turbo_confirm: 'Are you sure you want to finish this?' }, class: 'btn btn-info btn-sm ml-2' do %>
                Finish
              <% end %>
            <% end %>
            <% if @declare.submitted? %>
              <% if current_user.admin? %>
                <%= link_to approve_declare_path(@declare), data: { turbo_method: :post, turbo_confirm: 'Are you sure you want to approve this?' }, class: 'btn btn-info btn-sm ml-2' do %>
                  <i class="fas fa-check"></i> Approve
                <% end %>
                <%= link_to reject_declare_path(@declare), data: { turbo_method: :post, turbo_confirm: 'Are you sure you want to reject this?' }, class: 'btn btn-danger btn-sm ml-2' do %>
                  <i class="fas fa-check"></i> Reject
                <% end %>
              <% end %>
              <% if @declare.user_id == current_user.id %>
                <%= link_to edit_declare_path(@declare), class: 'btn btn-primary btn-sm ml-2' do %>
                  <i class="fas fa-pencil-alt"></i> Edit
                <% end %>
                <%= link_to declare_path(@declare), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm ml-2' do %>
                  <i class="fas fa-trash"></i> Delete
                <% end %>
              <% end %>
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <!-- /.card-body -->
</div>
<!-- /.card -->