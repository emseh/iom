<div id="bank_accounts">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Bank Account List</h3>
      <%= link_to new_bank_account_path, class: 'btn btn-success btn-sm float-right' do %>
        <i class="fa fa-plus-square"></i> New
      <% end %>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
      <table id="bank_accounts-table" class="table table-bordered table-striped">
        <thead>
          <tr>
            <th>Name</th>
            <th>Payout Channel Name</th>
            <th>Account Name</th>
            <th>Number</th>
            <th>Created At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @bank_accounts.each do |bank_account| %>
            <%= render bank_account %>
          <% end %>
        </tbody>
      </table>
      <%= paginate @bank_accounts %>
      <div class="mt-2">
        <%= page_entries_info @bank_accounts %>
      </div>
    </div>
  </div>
</div>
