<%= simple_form_for(profile, as: :profile, url: url, turbo_method: :turbo_method, html: { class: 'form-horizontal' }) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="card">
    <div class="card-body">
      <div class="form-group row">
        <%= f.label :email, class: 'col-sm-2 col-form-label' %>
        <div class="col-sm-10">
          <%= f.email_field :email, class: 'form-control', placeholder: 'Enter email', readonly: true %>
          <%= f.error :email, class: 'text-danger' %>
        </div>
      </div>

      <%= f.simple_fields_for (profile.user_information.present? ? :user_information : :user_information_attributes) do |ui| %>
        <div class="form-group row">
          <%= ui.label :full_name, class: 'col-sm-2 col-form-label' %>
          <div class="col-sm-10">
            <%= ui.text_field :full_name, class: 'form-control', placeholder: 'Enter full name' %>
            <%= ui.error :full_name, class: 'text-danger' %>
          </div>
        </div>

        <div class="form-group row">
          <%= ui.label :phone_number, class: 'col-sm-2 col-form-label' %>
          <div class="col-sm-10">
            <%= ui.number_field :phone_number, class: 'form-control', placeholder: 'Enter phone number', min: 0, step: 1 %>
            <%= ui.error :phone_number, class: 'text-danger' %>
          </div>
        </div>
      <% end %>
      <div class="form-group row">
        <%= f.label :patner, 'Patner', class: 'col-sm-2 col-form-label' %>
        <div class="col-sm-10">
          <%= f.text_field :patner, value: profile&.patner&.name_code, class: 'form-control', readonly: true %>
        </div>
      </div>
      <br><hr><br>
      <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
          <%= f.button :submit, class: 'btn btn-primary' %>
        </div>
      </div>
    </div>
  </div>
<% end %>
