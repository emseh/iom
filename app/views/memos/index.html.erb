<div id="memos">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Memo List</h3>
      <% if current_user.leader? %>
        <%= link_to new_memo_path, class: 'btn btn-success btn-sm float-right' do %>
          <i class="fa fa-plus-square"></i> New
        <% end %>
      <% end %>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
      <table id="memos-table" class="table table-bordered table-striped">
        <thead>
          <tr>
            <th><%= sort_link(@q, :user_user_information_full_name, 'Name') %></th>
            <th><%= sort_link(@q, :user_patner_patner_name, 'Patner') %></th>
            <th><%= sort_link(@q, :memo_category_id, 'Category') %></th>
            <th><%= sort_link(@q, :status, [:status, 'updated_at desc'], 'Status') %></th>
            <th><%= sort_link(@q, :amount, 'Amount') %></th>
            <th>Payout Channel</th>
            <th>Proof</th>
            <th><%= sort_link(@q, :created_at, 'Created At') %></th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @memos.each do |memo| %>
            <%= render memo %>
          <% end %>
        </tbody>
      </table>
      <%= paginate @memos %>
      <div class="mt-2">
        <%= page_entries_info @memos %>
      </div>
    </div>
  </div>
</div>
