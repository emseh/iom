<div id="<%= dom_id memo %>">
  <tr>
    <td><%= memo&.user&.user_information&.full_name %></td>
    <td><%= memo&.user&.patner&.name %></td>
    <td><%= memo&.memo_category&.name %></td>
    <td><%= memo&.status&.upcase %></td>
    <td><%= format_to_indonesian_currency(memo&.amount) %></td>
    <td><%= memo&.payout_channel&.code %></td>
    <td><%= memo&.memo_proof.present? ? 'Uploaded' : 'Not Uploaded' %></td>
    <td><%= formatted_date(memo&.created_at) %></td>
    <td>
      <%= link_to memo_path(memo), class: 'btn btn-secondary btn-sm' do %>
        <i class="fas fa-eye"></i> Show
      <% end %>
      <% if memo.user_id == current_user.id && memo.paid? %>
        <%= link_to edit_memo_path(memo), class: 'btn btn-primary btn-sm ml-2' do %>
          <i class="fas fa-pencil-alt"></i> Upload Proof
        <% end %>
      <% end %>
      <% if current_user.id == memo.user_id && memo.submitted? %>
        <%= link_to edit_memo_path(memo), class: 'btn btn-primary btn-sm ml-2' do %>
          <i class="fas fa-pencil-alt"></i> Edit
        <% end %>
        <%= link_to memo_path(memo), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm ml-2' do %>
          <i class="fas fa-trash"></i> Delete
        <% end %>
      <% end %>
    </td>
  </tr>
</div>
