<div id="payout_channels">
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">Declare Category List</h3>
      <%= link_to new_payout_channel_path, class: 'btn btn-success btn-sm float-right' do %>
        <i class="fa fa-plus-square"></i> New
      <% end %>
    </div>
    <!-- /.card-header -->
    <div class="card-body">
      <table id="payout_channels-table" class="table table-bordered table-striped">
        <thead>
          <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Payout Type</th>
            <th>Active</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @payout_channels.each do |payout_channel| %>
            <%= render payout_channel %>
          <% end %>
        </tbody>
      </table>
      <%= paginate @payout_channels %>
      <div class="mt-2">
        <%= page_entries_info @payout_channels %>
      </div>
    </div>
  </div>
</div>
