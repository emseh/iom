<div class="card">
  <div class="card-header">
    <h3 class="card-title">Patner Details</h3>
  </div>
  <!-- /.card-header -->
  <div class="card-body">
    <table class="table table-bordered table-striped" id="<%= dom_id(@payout_channel) %>">
      <tbody>
        <tr>
          <td><strong>Name</strong></td>
          <td><%= @payout_channel.name %></td>
        <tr>
          <td><strong>Code</strong></td>
          <td><%= @payout_channel.code %></td>
        </tr>
        <tr>
          <td><strong>Payout Type</strong></td>
          <td><%= @payout_channel.payout_type %></td>
        </tr>
        <tr>
          <td><strong>Active</strong></td>
          <td><%= @payout_channel.active ? '✓' : '-' %></td>
        </tr>
        <tr>
          <td colspan="3" class="text-right">
            <%= link_to payout_channels_path, class: 'btn btn-secondary btn-sm' do %>
              <i class="fa fa-chevron-left"></i> Back
            <% end %>
            <%= link_to edit_payout_channel_path(@payout_channel), class: 'btn btn-primary btn-sm ml-2' do %>
              <i class="fas fa-pencil-alt"></i> Edit
            <% end %>
            <%#= link_to payout_channel_path(@payout_channel), data: { turbo_method: :delete, turbo_confirm: 'Are you sure?' }, class: 'btn btn-danger btn-sm ml-2' do %>
<!--              <i class="fas fa-trash"></i> Delete-->
            <%# end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <!-- /.card-body -->
</div>
<!-- /.card -->