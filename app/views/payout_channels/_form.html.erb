<%= simple_form_for(@payout_channel, html: { class: 'form-horizontal' }) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <div class="card">
    <div class="card-body">
      <div class="form-group row">
          <%= f.label :active, class: 'form-check-label col-sm-2' %>
        <div class="form-check col-sm-10">
          <%= f.input :active, class: 'form-check-input', label: false %>
          <%= f.error :active, class: 'text-danger' %>
        </div>
      </div>
      <div class="form-group row">
        <div class="col-sm-10 offset-sm-2">
          <%= f.button :submit, class: 'btn btn-primary' %>
        </div>
      </div>
    </div>
  </div>
<% end %>
